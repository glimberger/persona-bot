# Talisman (pre-commit secret scanner) false positives. Each entry only silences one detector
# for one file, without a checksum, so it keeps working when the file changes.
fileignoreconfig:
  # flake.lock pins Nix inputs with content hashes and git revisions, not secrets.
  - filename: flake.lock
    ignore_detectors: [filecontent]
  # .envrc (direnv) matches the `.env` file name pattern; it only contains `use flake`.
  - filename: .envrc
    ignore_detectors: [filename]
  # .env.example is the template copied to .env: it lists the variables with empty values.
  # Only the file name check is skipped; its content is still scanned for secrets.
  - filename: .env.example
    ignore_detectors: [filename]
# Words that look like secrets to Talisman's pattern detector but are not.
allowed_patterns:
  # Fake Telegram token used by tests/test_logs.py to check that tokens are masked in logs.
  - "123456:TOKEN-SECRET"
  # French prose in persona prompts: "passionné" and "passage" contain "pass".
  - "passionné"
  - "passage"
version: "1.0"
