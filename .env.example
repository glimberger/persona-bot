# Copie ce fichier en .env et remplis les valeurs. Ne partage jamais .env.

# Modèle de langage : "claude" (API d'Anthropic) ou "ollama" (modèle local, gratuit).
LLM_BACKEND=claude

# Clé de l'API Claude : https://console.anthropic.com (inutile avec LLM_BACKEND=ollama)
ANTHROPIC_API_KEY=

# Avec LLM_BACKEND=ollama : le modèle (télécharge-le avec `ollama pull <modèle>`) et
# l'adresse du serveur Ollama (une autre machine du réseau est possible).
OLLAMA_MODEL=ministral-3:3b
OLLAMA_BASE_URL=http://localhost:11434

# Un bot Telegram par persona : un token par persona, donné par @BotFather (/newbot).
# Le nom de la variable est TELEGRAM_TOKEN_ suivi du slug de la persona (le nom de son
# dossier dans personas/) en majuscules. Une persona sans token n'a pas de bot Telegram.
# `uv run --env-file .env persona list` montre quelles personas ont un token.
TELEGRAM_TOKEN_JCVD=
TELEGRAM_TOKEN_GODEFROY=

# Identifiants Telegram autorisés à parler aux bots (la même liste pour toutes les
# personas), séparés par des virgules.
# Pour trouver le tien : lance les bots, envoie un message à l'un d'eux, et lis la ligne
# "Accès refusé à ... (id 123456789)" dans le terminal.
# Même procédure pour autoriser quelqu'un d'autre (voir README, "Autoriser une personne").
# Relance les bots après chaque modification : la liste n'est lue qu'au démarrage.
# Exemple : TELEGRAM_ALLOWED_USERS=123456789,987654321
TELEGRAM_ALLOWED_USERS=

# Une fois le modèle d'embeddings téléchargé, évite de contacter Hugging Face
# à chaque démarrage (et supprime l'avertissement HF_TOKEN).
HF_HUB_OFFLINE=1

# Mode debug : logs détaillés de chaque fonction et action (1 pour activer).
# Les logs contiennent alors le texte des messages : ne le laisse pas activé en permanence.
PERSONA_DEBUG=0
